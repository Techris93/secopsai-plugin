{
  "name": "@techris93/secopsai",
  "version": "1.0.2",
  "description": "Native SecOpsAI findings, triage, orchestration, and supply-chain investigation for OpenClaw",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.6.0"
  },
  "openclaw": {
    "compat": {
      "pluginApi": ">=2026.6.10"
    },
    "build": {
      "openclawVersion": "2026.3.31"
    },
    "extensions": [
      "./dist/index.js"
    ]
  },
  "keywords": [
    "openclaw",
    "secops",
    "security",
    "audit",
    "plugin"
  ],
  "author": "Techris",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Techris93/secopsai-plugin.git"
  },
  "homepage": "https://github.com/Techris93/secopsai-plugin#readme"
}
